# =============================================================
# QLENTRA — Environment Variables
# Copy this file to .env.local for local development, and add
# the same keys in your Vercel Project Settings for production.
# =============================================================

# Calendly scheduling page URL used by every "Book a Discovery Call" CTA.
# Example: https://calendly.com/qlentra/discovery-call
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/qlentra/discovery-call

# The canonical production URL of the website (no trailing slash).
# Used for SEO metadata, canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.qlentracx.com

# Official LinkedIn company page.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/qlentra-cx/

# Public contact email shown across the site.
NEXT_PUBLIC_CONTACT_EMAIL=support@qlentracx.com

# =============================================================
# Contact form email delivery (Resend)
# =============================================================
# Server-side secret — do NOT prefix with NEXT_PUBLIC_.
# Get this from https://resend.com after creating a free account.
RESEND_API_KEY=

# The "from" address emails are sent from. Use Resend's shared test sender
# (onboarding@resend.dev) until you verify your own domain in the Resend
# dashboard, then switch to something like: Qlentra Website <no-reply@qlentracx.com>
CONTACT_FROM_EMAIL=Qlentra Website <onboarding@resend.dev>
